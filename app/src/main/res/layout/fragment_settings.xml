<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="150dp">

        <!-- ================================= -->
        <!-- SETTINGS PAGE HEADER              -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#24292F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your account and preferences."
            android:textColor="#68717D"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="22dp" />

        <!-- ================================= -->
        <!-- ACCOUNT SETTINGS CARD             -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account Settings"
                    android:textColor="#008DBB"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update your personal information."
                    android:textColor="#68717D"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp" />

                <!-- FIRST NAME LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- FIRST NAME INPUT -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="@color/settings_field_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsFirst"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLength="80"
                        android:minHeight="56dp"
                        android:hint="Enter first name"
                        android:textColor="#24292F"
                        android:textColorHint="#98A2AD"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- LAST NAME LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- LAST NAME INPUT -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="@color/settings_field_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsLast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLength="80"
                        android:minHeight="56dp"
                        android:hint="Enter last name"
                        android:textColor="#24292F"
                        android:textColorHint="#98A2AD"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- PHONE NUMBER LABEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- PHONE NUMBER INPUT -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="@color/settings_field_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settingsPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="20"
                        android:minHeight="56dp"
                        android:hint="Enter phone number"
                        android:textColor="#24292F"
                        android:textColorHint="#98A2AD"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ACCOUNT EMAIL -->
                <TextView
                    android:id="@+id/settingsEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading account email..."
                    android:textColor="#59636F"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp" />

                <!-- SAVE PROFILE BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Save Profile"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#008DBB"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- APP PREFERENCES CARD              -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Preferences"
                    android:textColor="#008DBB"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Allow in-app update notices"
                    android:textColor="#24292F"
                    app:showText="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This saves your preference for future notification features."
                    android:textColor="#68717D"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- CHANGE PASSWORD BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Change Password"
            android:textColor="#FFFFFF"
            app:backgroundTint="#008DBB"
            app:cornerRadius="14dp" />


        <!-- ================================= -->
        <!-- ADMIN DASHBOARD BUTTON            -->
        <!-- ================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminDashboard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Admin Dashboard"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#008DBB"
            app:cornerRadius="14dp" />

        <!-- HELP AND SUPPORT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Help and Support"
            android:textColor="#FFFFFF"
            app:backgroundTint="#555555"
            app:cornerRadius="14dp" />

        <!-- LOGOUT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Log Out"
            android:textColor="#FFFFFF"
            app:backgroundTint="#333333"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>